# Django REST API base URL (required).
# Use the full origin, e.g. https://api.dearcompany.app
# or `/` to call the same origin the web build is served from (reverse proxy).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Identity Services web client id. The Google button is hidden when unset.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public web origin, used to build Stripe success/cancel return URLs on native.
EXPO_PUBLIC_WEB_ORIGIN=

# Per-request timeout in ms (default 30000). AI/upload calls set their own.
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=30000
